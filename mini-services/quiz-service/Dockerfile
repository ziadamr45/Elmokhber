FROM oven/bun:latest AS base

WORKDIR /app

# Copy package files (bun.lock will be generated by bun install)
COPY package.json ./

# Install dependencies
RUN bun install

# Copy source code
COPY . .

# Expose port (Railway sets PORT env var)
EXPOSE 3000

# Start the service
CMD ["bun", "run", "index.ts"]
